# コピーして .env にしてください: copy .env.example .env
DATABASE_URL=postgres://postgres:password@localhost:5432/passkey_app
SESSION_SECRET=ここを長いランダム文字列に変更
PORT=3000

# WebAuthn (Passkey) 設定
# RP_ID はドメイン名のみ（ポート・スキームなし）。ローカル開発は localhost
RP_ID=localhost
RP_NAME=Passkey Demo
# ブラウザで開くURLと完全一致させる（スキーム + ホスト + ポート）
ORIGIN=http://localhost:3000

# true: この端末の認証器（Windows Hello / Touch ID など）のみ
# false: スマホ(QR)やセキュリティキーも許可
PLATFORM_ONLY=true
